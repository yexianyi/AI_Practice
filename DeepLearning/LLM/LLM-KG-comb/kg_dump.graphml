      <data key="d2">Motor-Unit-A</data>
      <data key="d8">15kW</data>
    </node>
    
    <node id="n5">
      <data key="d0">FaultMode</data>
      <data key="d1">F001</data>
      <data key="d2">Overheating</data>
      <data key="d9">High</data>
      <data key="d10">Temperature exceeds safety threshold.</data>
    </node>
    <node id="n6">
      <data key="d0">FaultMode</data>
      <data key="d1">F002</data>
      <data key="d2">AbnormalVibration</data>
      <data key="d9">Medium</data>
      <data key="d10">Vibration values exceed ISO standard.</data>
    </node>
    <node id="n7">
      <data key="d0">FaultMode</data>
      <data key="d1">F003</data>
      <data key="d2">PowerLoss</data>
      <data key="d9">High</data>
      <data key="d10">Motor fails to achieve rated power.</data>
