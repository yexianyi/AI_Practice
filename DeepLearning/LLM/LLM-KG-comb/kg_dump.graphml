      <data key="d1">R003</data>
      <data key="d2">InspectWiring</data>
      <data key="d11">1h</data>
    </node>
    
    <edge source="n0" target="n2">
      <data key="d13">HAS_COMPONENT</data>
    </edge>
    <edge source="n0" target="n3">
      <data key="d13">HAS_COMPONENT</data>
