<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d0" for="node" attr.name="label" attr.type="string"/>
  <key id="d1" for="node" attr.name="id" attr.type="string"/>
  <key id="d2" for="node" attr.name="name" attr.type="string"/>
  <key id="d3" for="node" attr.name="location" attr.type="string"/>
  <key id="d4" for="node" attr.name="model" attr.type="string"/>
  <key id="d5" for="node" attr.name="lifespan" attr.type="string"/>
  <key id="d6" for="node" attr.name="supplier" attr.type="string"/>
  <key id="d7" for="node" attr.name="material" attr.type="string"/>
  <key id="d8" for="node" attr.name="power" attr.type="string"/>
  <key id="d9" for="node" attr.name="severity" attr.type="string"/>
  <key id="d10" for="node" attr.name="description" attr.type="string"/>
  <key id="d11" for="node" attr.name="estimated_time" attr.type="string"/>
  <key id="d12" for="node" attr.name="required_tool" attr.type="string"/>
  <key id="d13" for="edge" attr.name="label" attr.type="string"/>
  
  <graph id="G" edgedefault="directed">
    
    <node id="n0">
      <data key="d0">Device</data>
      <data key="d1">D001</data>
      <data key="d2">CNC-M500</data>
      <data key="d3">Line-A</data>
      <data key="d4">M500-Pro</data>
    </node>
    <node id="n1">
      <data key="d0">Device</data>
      <data key="d1">D002</data>
