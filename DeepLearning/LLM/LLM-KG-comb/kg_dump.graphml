      <data key="d3">Line-B</data>
      <data key="d4">KR40-V2</data>
    </node>
    
    <node id="n2">
      <data key="d0">Component</data>
      <data key="d1">C001</data>
      <data key="d2">Spindle-Unit-001</data>
      <data key="d5">5000h</data>
      <data key="d6">Siemens</data>
